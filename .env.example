# Clave de la API de Anthropic. Solo se usa con --llm anthropic (o LINOTIPO_LLM_PROVIDER=anthropic).
ANTHROPIC_API_KEY=

# Locale e idioma de la edición (BCP 47).
LINOTIPO_LOCALE=es-ES

# Región geográfica de la edición (ISO 3166-1 alpha-2).
LINOTIPO_REGION=ES

# Proveedor de LLM: fake (sin tokens, para desarrollo y tests) o anthropic.
LINOTIPO_LLM_PROVIDER=fake

# Feeds RSS separados por coma. Si está vacío se usa la lista por defecto del adaptador.
LINOTIPO_RSS_FEEDS=
